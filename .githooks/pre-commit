#!/bin/sh
# Builds the Astro site and stages the fresh docs/ output on every commit.
# Aborts the commit if the build fails, so master never contains a broken build.
#
# Installed automatically for anyone who clones this repo via:
#   git config core.hooksPath .githooks

echo "→ Building site (pre-commit hook)..."
npm run build --silent

if [ $? -ne 0 ]; then
  echo ""
  echo "✗ Build failed — commit aborted. Fix the error above and try again."
  exit 1
fi

git add docs
echo "✓ Build succeeded, docs/ staged."
