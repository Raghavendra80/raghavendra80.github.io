---
const links = [
  { label: 'GitHub', href: 'https://github.com/Raghavendra80' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/80raghavendra' },
  { label: 'X', href: 'https://twitter.com/80Raghavendra' },
  { label: 'Google Scholar', href: 'https://scholar.google.co.in/citations?user=JZik0U0AAAAJ&hl=en' },
  { label: 'ORCID', href: 'https://orcid.org/0000-0002-6289-9723' },
  { label: 'Supra', href: 'https://supra.com/research-team/raghavendra/' },
