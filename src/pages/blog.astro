---
import BaseLayout from '../layouts/BaseLayout.astro';

const posts = [
  {
    title: "The Bridge Comes Full Circle: Announcing Supra's Reverse Bridge to Ethereum",
    href: 'https://medium.com/@raghavendra.kaundinya/the-bridge-comes-full-circle-announcing-supras-reverse-bridge-to-ethereum-41ea3b6c23ec',
  },
  {
    title: 'Blockchain Interoperability: An Overview of the Current Research',
    href: 'https://consensys.io/blog/blockchain-interoperability-an-overview-of-the-current-research/',
  },
  {
    title: 'Crypto — The Transformative Power of Decentralisation, Channelled Through Governments (United States)',
    href: 'https://medium.com/@raghavendra.kaundinya/crypto-the-transformative-power-of-decentralisation-channelled-through-governments-e6f885cd0313',
  },
  {
    title: 'Crypto — The Transformative Power of Decentralisation, Channelled Through Governments (India)',
    href: 'https://medium.com/@raghavendra.kaundinya/crypto-the-transformative-power-of-decentralisation-channelled-through-governments-cae5312f4705',
  },
].map((post) => ({ ...post, source: new URL(post.href).hostname.replace('www.', '') }));
---
<BaseLayout title="Blogs" description="Blog posts by Raghavendra Ramesh.">
  <section class="section wrap reveal" style="border-top: none;">
    <h2>Blogs</h2>
    <div class="blog-grid">
      {posts.map((post) => (
        <a class="card blog-card" href={post.href} target="_blank" rel="noopener noreferrer">
          <p class="pill">{post.source}</p>
          <h3 class="blog-card__title">{post.title}</h3>
          <span class="blog-card__link" aria-hidden="true">Read →</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .blog-card {
    display: flex;
    flex-direction: column;
    color: var(--text);
    height: 100%;
  }

  .blog-card__title {
    font-size: 1rem;
    margin: 0.5rem 0 1rem;
    flex-grow: 1;
  }

  .blog-card__link {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
  }
</style>
